    <!-- GAME ENGINE & HAND TRACKING JAVASCRIPT LOGIC -->
    <script>
        /* ==========================================================================
           GLOBAL GAME STATE & CONFIGURATION
           ========================================================================== */
        const state = {
            mode: 'solo', // 'solo' | 'battle'
            sensitivity: 'high', // 'low' | 'medium' | 'high'
            hitBoxMultiplier: 1.5, // Hitbox size vs visual size
            audioEnabled: true,
            
            // Gameplay Variables
            targetNumber: 0,
            scoreSolo: 0,
            scoreP1: 0,
            scoreP2: 0,
            timeLeft: 60,
            gameActive: false,
            timerInterval: null,
            
            // Mosquitoes array
            mosquitoes: [],
            
            // Hand Tracking Data
            detectedHands: [], // Array of smoothed palm centers [{x, y, rawX, rawY, id}]
            prevHandPositions: {}, // For sweep collision checking
            
            // Performance tracking
            fps: 0,
            frameCount: 0,
            lastFpsUpdate: Date.now(),
            
            // Camera & MediaPipe instances
            handsEngine: null,
            cameraUtils: null,
            activeVideoStream: null
        };

        // DOM Element Cache
        const DOM = {
            screens: {
                menu: document.getElementById('screenMenu'),
                calib: document.getElementById('screenCalibration'),
                game: document.getElementById('screenGameplay'),
                result: document.getElementById('screenResult')
            },
            btnHome: document.getElementById('btnHome'),
            webcamCalib: document.getElementById('webcamCalib'),
            canvasCalib: document.getElementById('canvasCalib'),
            calibOverlay: document.getElementById('calibStatusOverlay'),
            calibStatusHeading: document.getElementById('calibStatusHeading'),
            calibStatusDesc: document.getElementById('calibStatusDesc'),
            btnStartGame: document.getElementById('btnStartGame'),
            
            gameplayVideo: document.getElementById('gameplayVideo'),
            gameCanvas: document.getElementById('gameCanvas'),
            battleDivider: document.getElementById('battleDivider'),
            
            targetNumberDisplay: document.getElementById('targetNumberDisplay'),
            targetInstructionText: document.getElementById('targetInstructionText'),
            gameTimerDisplay: document.getElementById('gameTimerDisplay'),
            
            scoreBoardSolo: document.getElementById('scoreBoardSolo'),
            scoreBoardBattle: document.getElementById('scoreBoardBattle'),
            soloScoreDisplay: document.getElementById('soloScoreDisplay'),
            battleP1ScoreDisplay: document.getElementById('battleP1ScoreDisplay'),
            battleP2ScoreDisplay: document.getElementById('battleP2ScoreDisplay'),
            
            feedbackToast: document.getElementById('feedbackToast'),
            feedbackToastBg: document.getElementById('feedbackToastBg'),
            feedbackIcon: document.getElementById('feedbackIcon'),
            feedbackText: document.getElementById('feedbackText'),
            
            diagPanel: document.getElementById('diagPanel'),
            diagCamStatus: document.getElementById('diagCamStatus'),
            diagHandCount: document.getElementById('diagHandCount'),
            diagFPS: document.getElementById('diagFPS'),
            diagSens: document.getElementById('diagSens'),
            diagCollision: document.getElementById('diagCollision')
        };

        /* ==========================================================================
           SPEECH SYNTHESIS & AUDIO SYSTEM
           ========================================================================== */
        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();

        function playSound(type) {
            if (!state.audioEnabled) return;
            try {
                if (audioCtx.state === 'suspended') audioCtx.resume();
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.connect(gain);
                gain.connect(audioCtx.destination);

                if (type === 'splat') {
                    // Correct answer catch sound
                    osc.type = 'triangle';
                    osc.frequency.setValueAtTime(300, audioCtx.currentTime);
                    osc.frequency.exponentialRampToValueAtTime(800, audioCtx.currentTime + 0.15);
                    gain.gain.setValueAtTime(0.2, audioCtx.currentTime);
                    gain.gain.linearRampToValueAtTime(0.01, audioCtx.currentTime + 0.15);
                    osc.start();
                    osc.stop(audioCtx.currentTime + 0.15);
                } else if (type === 'wrong') {
                    // Wrong answer catch sound
                    osc.type = 'sawtooth';
                    osc.frequency.setValueAtTime(180, audioCtx.currentTime);
                    osc.frequency.setValueAtTime(120, audioCtx.currentTime + 0.2);
                    gain.gain.setValueAtTime(0.2, audioCtx.currentTime);
                    gain.gain.linearRampToValueAtTime(0.01, audioCtx.currentTime + 0.2);
                    osc.start();
                    osc.stop(audioCtx.currentTime + 0.2);
                } else if (type === 'click') {
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(500, audioCtx.currentTime);
                    gain.gain.setValueAtTime(0.05, audioCtx.currentTime);
                    gain.gain.linearRampToValueAtTime(0.01, audioCtx.currentTime + 0.05);
                    osc.start();
                    osc.stop(audioCtx.currentTime + 0.05);
                }
            } catch (e) {
                console.log("Audio play error:", e);
            }
        }

        function speakInstruction(text) {
            if (!state.audioEnabled || !('speechSynthesis' in window)) return;
            
            // Cancel any ongoing speech
            window.speechSynthesis.cancel();

            const utterance = new SpeechSynthesisUtterance(text);
            utterance.lang = 'id-ID'; // Indonesian Language
            utterance.rate = 1.0;
            utterance.pitch = 1.1; // Slightly higher pitch for kids
            
            window.speechSynthesis.speak(utterance);
        }

        function toggleAudioSetting() {
            state.audioEnabled = !state.audioEnabled;
            const icon = document.getElementById('soundIcon');
            const text = document.getElementById('soundText');
            
            if (state.audioEnabled) {
                icon.className = 'fa-solid fa-volume-high text-emerald-400';
                text.innerText = 'Suara: ON';
                playSound('click');
            } else {
                icon.className = 'fa-solid fa-volume-xmark text-rose-400';
                text.innerText = 'Suara: OFF';
                window.speechSynthesis.cancel();
            }
        }

        /* ==========================================================================
           MEDIAPIPE HAND TRACKING INITIALIZATION
           ========================================================================== */
        function initMediaPipe() {
            if (state.handsEngine) return;

            state.handsEngine = new Hands({
                locateFile: (file) => `https://cdn.jsdelivr.net/npm/@mediapipe/hands/${file}`
            });

            state.handsEngine.setOptions({
                maxNumHands: 2, // Support up to 2 hands for Battle mode
                modelComplexity: 1,
                minDetectionConfidence: 0.5,
                minTrackingConfidence: 0.5
            });

            state.handsEngine.onResults(onHandResults);
        }

        function onHandResults(results) {
            // Calculate FPS
            state.frameCount++;
            const now = Date.now();
            if (now - state.lastFpsUpdate >= 1000) {
                state.fps = state.frameCount;
                state.frameCount = 0;
                state.lastFpsUpdate = now;
                DOM.diagFPS.innerText = state.fps;
            }

            const rawHands = [];
            if (results.multiHandLandmarks && results.multiHandLandmarks.length > 0) {
                results.multiHandLandmarks.forEach((landmarks, index) => {
                    // Landmark 9 is Middle Finger MCP (Palm Center Reference)
                    // Landmark 0 is Wrist
                    const palmCenterX = (landmarks[9].x + landmarks[0].x) / 2;
                    const palmCenterY = (landmarks[9].y + landmarks[0].y) / 2;

                    // Mirroring correction (because camera feed is flipped horizontally for mirror view)
                    const mirroredX = 1.0 - palmCenterX;

                    rawHands.push({
                        id: index,
                        x: mirroredX,
                        y: palmCenterY,
                        landmarks: landmarks
                    });
                });
            }

            // Apply light exponential smoothing for zero latency feel
            const smoothedHands = [];
            rawHands.forEach(hand => {
                const prev = state.prevHandPositions[hand.id] || { x: hand.x, y: hand.y };
                const alpha = 0.65; // High responsiveness factor
                const smoothX = prev.x + alpha * (hand.x - prev.x);
                const smoothY = prev.y + alpha * (hand.y - prev.y);

                state.prevHandPositions[hand.id] = { x: smoothX, y: smoothY };

                smoothedHands.push({
                    id: hand.id,
                    x: smoothX,
                    y: smoothY,
                    prevX: prev.x,
                    prevY: prev.y
                });
            });

            state.detectedHands = smoothedHands;
            DOM.diagHandCount.innerText = state.detectedHands.length;

            // Calibration Screen Handling
            if (!DOM.screens.calib.classList.contains('hidden')) {
                renderCalibrationFrame(results);
            }
        }

        /* ==========================================================================
           CAMERA STREAM CONTROLLER
           ========================================================================== */
        async function startCamera(videoElement) {
            try {
                initMediaPipe();
                DOM.diagCamStatus.innerText = 'Menghubungkan...';
                DOM.diagCamStatus.className = 'text-amber-400';

                // Reset UI overlay state
                const retryBtn = document.getElementById('btnRetryCam');
                const iconBox = document.getElementById('calibStatusIcon');
                if (retryBtn) retryBtn.classList.add('hidden');
                if (iconBox) {
                    iconBox.className = "w-16 h-16 bg-amber-500/20 text-amber-400 rounded-full flex items-center justify-center text-3xl mb-3 animate-pulse";
                    iconBox.innerHTML = '<i class="fa-solid fa-camera"></i>';
                }

                if (state.cameraUtils) {
                    await state.cameraUtils.stop();
                }

                state.cameraUtils = new Camera(videoElement, {
                    onFrame: async () => {
                        if (videoElement.readyState >= 2) {
                            await state.handsEngine.send({ image: videoElement });
                        }
                    },
                    width: 640,
                    height: 480
                });

                await state.cameraUtils.start();
                DOM.diagCamStatus.innerText = 'Aktif (640x480)';
                DOM.diagCamStatus.className = 'text-emerald-400';
                return true;
            } catch (err) {
                console.error("Camera access error:", err);
                DOM.diagCamStatus.innerText = 'Gagal Akses';
                DOM.diagCamStatus.className = 'text-rose-400';

                // Handle Permission Denied or Missing Hardware Error UI
                if (err.name === 'NotAllowedError' || err.message.includes('Permission denied') || err.message.includes('Permission')) {
                    DOM.calibStatusHeading.innerText = 'Akses Kamera Ditolak';
                    DOM.calibStatusDesc.innerText = 'Klik ikon gembok/kamera di bilah alamat browser kamu, izinkan akses kamera, lalu klik tombol di bawah.';
                } else if (err.name === 'NotFoundError' || err.message.includes('DevicesNotFoundError')) {
                    DOM.calibStatusHeading.innerText = 'Kamera Tidak Ditemukan';
                    DOM.calibStatusDesc.innerText = 'Pastikan webcam atau kamera perangkat kamu terhubung dengan benar.';
                } else {
                    DOM.calibStatusHeading.innerText = 'Gagal Membuka Kamera';
                    DOM.calibStatusDesc.innerText = 'Terjadi kesalahan saat menghubungkan ke webcam.';
                }

                const retryBtn = document.getElementById('btnRetryCam');
                const iconBox = document.getElementById('calibStatusIcon');
                if (retryBtn) retryBtn.classList.remove('hidden');
                if (iconBox) {
                    iconBox.className = "w-16 h-16 bg-rose-500/20 text-rose-400 rounded-full flex items-center justify-center text-3xl mb-3";
                    iconBox.innerHTML = '<i class="fa-solid fa-video-slash"></i>';
                }

                return false;
            }
        }

        async function retryCameraAccess() {
            DOM.calibStatusHeading.innerText = 'Meminta Izin Kamera...';
            DOM.calibStatusDesc.innerText = 'Klik "Izinkan" jika browser menampilkan pop-up izin kamera.';
            playSound('click');
