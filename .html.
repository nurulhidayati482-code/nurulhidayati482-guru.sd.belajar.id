        async function selectGameMode(mode) {
            playSound('click');
            state.mode = mode;
            switchScreen('calib');

            // Speech audio prompt
            speakInstruction("Tunjukkan tanganmu di depan kamera!");

            // Start Camera feed for calibration
            await startCamera(DOM.webcamCalib);
        }

        async function startGameplay() {
            playSound('click');
            switchScreen('game');

            // Reset scores & timers
            state.scoreSolo = 0;
            state.scoreP1 = 0;
            state.scoreP2 = 0;
            state.timeLeft = 60;
            state.gameActive = true;

            DOM.soloScoreDisplay.innerText = '0';
            DOM.battleP1ScoreDisplay.innerText = '0';
            DOM.battleP2ScoreDisplay.innerText = '0';
            DOM.gameTimerDisplay.innerText = '60s';

            // Configure HUD based on mode
            if (state.mode === 'solo') {
                DOM.scoreBoardSolo.classList.remove('hidden');
                DOM.scoreBoardBattle.classList.add('hidden');
                DOM.battleDivider.classList.add('hidden');
            } else {
                DOM.scoreBoardSolo.classList.add('hidden');
                DOM.scoreBoardBattle.classList.remove('hidden');
                DOM.battleDivider.classList.remove('hidden');
            }

            // Start Camera feed on main gameplay video element
            await startCamera(DOM.gameplayVideo);

            // Start Countdown Timer
            clearInterval(state.timerInterval);
            state.timerInterval = setInterval(() => {
                state.timeLeft--;
                DOM.gameTimerDisplay.innerText = `${state.timeLeft}s`;

                if (state.timeLeft <= 0) {
                    endGameplay();
                }
            }, 1000);

            // Start first round
            startNewRound();

            // Run Game Loop
            runGameLoop();
        }

        function endGameplay() {
            state.gameActive = false;
            clearInterval(state.timerInterval);
            playSound('splat');
            switchScreen('result');

            if (state.mode === 'solo') {
                document.getElementById('resultSoloCard').classList.remove('hidden');
                document.getElementById('resultBattleCard').classList.add('hidden');
                document.getElementById('finalSoloScore').innerText = state.scoreSolo;
                speakInstruction(`Permainan selesai! Skor kamu adalah ${state.scoreSolo}`);
            } else {
                document.getElementById('resultSoloCard').classList.add('hidden');
                document.getElementById('resultBattleCard').classList.remove('hidden');
                document.getElementById('finalBattleP1Score').innerText = state.scoreP1;
                document.getElementById('finalBattleP2Score').innerText = state.scoreP2;

                const winnerText = document.getElementById('battleWinnerText');
                if (state.scoreP1 > state.scoreP2) {
                    winnerText.innerText = "🏆 Pemain 1 (Kiri) Menang!";
                    speakInstruction("Pemain satu menang!");
                } else if (state.scoreP2 > state.scoreP1) {
                    winnerText.innerText = "🏆 Pemain 2 (Kanan) Menang!";
                    speakInstruction("Pemain dua menang!");
                } else {
                    winnerText.innerText = "🤝 Hasil Seri!";
                    speakInstruction("Hasil pertandingan seri!");
                }
            }
        }

        function restartGameplay() {
            startGameplay();
        }

        function returnToMainMenu() {
            playSound('click');
            state.gameActive = false;
            clearInterval(state.timerInterval);
            if (window.speechSynthesis) window.speechSynthesis.cancel();
            switchScreen('menu');
        }

        function toggleDiagPanel() {
            DOM.diagPanel.classList.toggle('hidden');
        }

        // Initialize default screen
        window.onload = function() {
            switchScreen('menu');
        };
    </script>
</body>
</html>
