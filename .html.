        }

        /* ==========================================================================
           CALIBRATION & CAMERA PREVIEW
           ========================================================================== */
        function renderCalibrationFrame() {
            const canvas = DOM.canvasCalib;
            const ctx = canvas.getContext('2d');
            const video = DOM.webcamCalib;

            if (canvas.width !== video.videoWidth || canvas.height !== video.videoHeight) {
                canvas.width = video.videoWidth || 640;
                canvas.height = video.videoHeight || 480;
            }

            // Draw mirrored video feed
            ctx.save();
            ctx.scale(-1, 1);
            ctx.drawImage(video, -canvas.width, 0, canvas.width, canvas.height);
            ctx.restore();

            // Overlay Hand Markers
            if (state.detectedHands.length > 0) {
                DOM.calibOverlay.classList.add('opacity-0', 'pointer-events-none');
                DOM.btnStartGame.disabled = false;

                state.detectedHands.forEach((hand, idx) => {
                    const posX = hand.x * canvas.width;
                    const posY = hand.y * canvas.height;

                    // Outer tracking circle
                    ctx.beginPath();
                    ctx.arc(posX, posY, 35, 0, Math.PI * 2);
                    ctx.fillStyle = idx === 0 ? 'rgba(16, 185, 129, 0.3)' : 'rgba(168, 85, 247, 0.3)';
                    ctx.fill();
                    ctx.lineWidth = 3;
                    ctx.strokeStyle = idx === 0 ? '#10b981' : '#a855f7';
                    ctx.stroke();

                    // Center Hand Point
                    ctx.beginPath();
                    ctx.arc(posX, posY, 8, 0, Math.PI * 2);
                    ctx.fillStyle = '#ffffff';
                    ctx.fill();

                    // Label
                    ctx.fillStyle = '#ffffff';
                    ctx.font = 'bold 12px Fredoka';
                    ctx.fillText(state.mode === 'battle' ? `Tangan P${idx+1}` : 'Tangan Kamu', posX - 30, posY - 45);
                });
            } else {
                DOM.btnStartGame.disabled = true;
                DOM.calibOverlay.classList.remove('opacity-0', 'pointer-events-none');
                DOM.calibStatusHeading.innerText = 'Tunjukkan Tanganmu';
                DOM.calibStatusDesc.innerText = 'Angkat tangan di depan webcam hingga kursor penanda muncul.';
            }
        }

        /* ==========================================================================
           GAMEPLAY ENGINE & MOSQUITO SPAWNING
           ========================================================================== */
        class Mosquito {
            constructor(number, isTarget, areaSide = 'full', canvasWidth, canvasHeight) {
                this.number = number;
                this.isTarget = isTarget;
                this.areaSide = areaSide; // 'full' | 'left' | 'right'
                this.radius = 35; // Visual radius
                this.hitRadius = this.radius * state.hitBoxMultiplier;
                
                // Set initial coordinates based on side assignment
                let minX = 60;
                let maxX = canvasWidth - 60;
                
                if (areaSide === 'left') {
                    maxX = (canvasWidth / 2) - 60;
                } else if (areaSide === 'right') {
                    minX = (canvasWidth / 2) + 60;
                }

                this.x = minX + Math.random() * Math.max(20, (maxX - minX));
                this.y = 80 + Math.random() * (canvasHeight - 160);

                // Flight velocity
                this.vx = (Math.random() - 0.5) * 2.5;
                this.vy = (Math.random() - 0.5) * 2.5;
                this.wingPhase = Math.random() * Math.PI * 2;
            }

            update(canvasWidth, canvasHeight) {
                this.x += this.vx;
                this.y += this.vy;
                this.wingPhase += 0.3;

                // Bounce off walls according to allowed area
                let minX = this.radius;
                let maxX = canvasWidth - this.radius;

                if (this.areaSide === 'left') {
                    maxX = (canvasWidth / 2) - this.radius;
                } else if (this.areaSide === 'right') {
                    minX = (canvasWidth / 2) + this.radius;
                }

                if (this.x < minX || this.x > maxX) this.vx *= -1;
                if (this.y < this.radius + 60 || this.y > canvasHeight - this.radius) this.vy *= -1;
            }

            draw(ctx) {
                ctx.save();
                ctx.translate(this.x, this.y);

                // Draw Mosquito Wings (Animated)
                const wingY = Math.sin(this.wingPhase) * 8;
                ctx.fillStyle = 'rgba(255, 255, 255, 0.6)';
                ctx.beginPath();
                ctx.ellipse(-15, -15 + wingY, 14, 6, -Math.PI / 4, 0, Math.PI * 2);
                ctx.ellipse(15, -15 - wingY, 14, 6, Math.PI / 4, 0, Math.PI * 2);
                ctx.fill();

                // Mosquito Body (Cartoon Circle)
                ctx.beginPath();
                ctx.arc(0, 0, this.radius, 0, Math.PI * 2);
                ctx.fillStyle = '#1e293b'; // Slate dark body
                ctx.fill();
                ctx.lineWidth = 3;
                ctx.strokeStyle = this.isTarget ? '#f59e0b' : '#64748b'; // Gold border for target
                ctx.stroke();

                // Mosquito Eyes
                ctx.fillStyle = '#ef4444';
                ctx.beginPath();
                ctx.arc(-10, -10, 5, 0, Math.PI * 2);
                ctx.arc(-2, -12, 5, 0, Math.PI * 2);
                ctx.fill();

                // Number Badge on Mosquito Center
                ctx.beginPath();
                ctx.arc(0, 8, 18, 0, Math.PI * 2);
                ctx.fillStyle = '#ffffff';
                ctx.fill();

                ctx.fillStyle = '#0f172a';
                ctx.font = 'black 20px Fredoka';
                ctx.textAlign = 'center';
                ctx.textBaseline = 'middle';
                ctx.fillText(this.number.toString(), 0, 9);

                ctx.restore();
            }
        }

        function startNewRound() {
            // Pick new target number (0-9)
            state.targetNumber = Math.floor(Math.random() * 10);
            DOM.targetNumberDisplay.innerText = state.targetNumber;

            const text = `Tangkap nyamuk yang membawa angka ${numberToWord(state.targetNumber)}!`;
            DOM.targetInstructionText.innerText = text;
            speakInstruction(text);

            // Spawn Mosquitoes
            spawnMosquitoCluster();
        }

        function numberToWord(num) {
            const words = ["nol", "satu", "dua", "tiga", "empat", "lima", "enam", "tujuh", "delapan", "sembilan"];
            return words[num] || num.toString();
        }

        function spawnMosquitoCluster() {
            state.mosquitoes = [];
            const canvas = DOM.gameCanvas;

            if (state.mode === 'solo') {
                // Spawn 1 Target Mosquito + 3 Distractor Mosquitoes
                state.mosquitoes.push(new Mosquito(state.targetNumber, true, 'full', canvas.width, canvas.height));

                const distractors = [];
                while (distractors.length < 3) {
                    const rnd = Math.floor(Math.random() * 10);
                    if (rnd !== state.targetNumber && !distractors.includes(rnd)) {
                        distractors.push(rnd);
                    }
                }
                distractors.forEach(num => {
                    state.mosquitoes.push(new Mosquito(num, false, 'full', canvas.width, canvas.height));
                });

            } else if (state.mode === 'battle') {
                // Spawn 1 Target + 2 Distractors on Left side (P1)
                state.mosquitoes.push(new Mosquito(state.targetNumber, true, 'left', canvas.width, canvas.height));
                let rndL = (state.targetNumber + 1) % 10;
                state.mosquitoes.push(new Mosquito(rndL, false, 'left', canvas.width, canvas.height));

                // Spawn 1 Target + 2 Distractors on Right side (P2)
                state.mosquitoes.push(new Mosquito(state.targetNumber, true, 'right', canvas.width, canvas.height));
                let rndR = (state.targetNumber + 2) % 10;
                state.mosquitoes.push(new Mosquito(rndR, false, 'right', canvas.width, canvas.height));
            }
        }

        /* ==========================================================================
           SWEEP COLLISION DETECTION (LINE SEGMENT TO CIRCLE)
           ========================================================================== */
        function checkHandCollision(hand, mosquito, canvasWidth, canvasHeight) {
            const hx = hand.x * canvasWidth;
            const hy = hand.y * canvasHeight;
            const px = hand.prevX * canvasWidth;
            const py = hand.prevY * canvasHeight;

            const mx = mosquito.x;
            const my = mosquito.y;
            const radius = mosquito.hitRadius;

            // Distance from current hand point to mosquito center
            const distCurrent = Math.hypot(hx - mx, hy - my);
            if (distCurrent <= radius) return true;

            // Distance from previous hand point to mosquito center (Sweep check)
            const distPrev = Math.hypot(px - mx, py - my);
            if (distPrev <= radius) return true;

            return false;
        }

        /* ==========================================================================
           GAME LOOP & RENDERER
           ========================================================================== */
        function runGameLoop() {
            if (!state.gameActive) return;

            const canvas = DOM.gameCanvas;
            const ctx = canvas.getContext('2d');
            const video = DOM.gameplayVideo;

            if (canvas.width !== video.videoWidth || canvas.height !== video.videoHeight) {
                canvas.width = video.videoWidth || 640;
                canvas.height = video.videoHeight || 480;
            }

            // 1. Draw mirrored background video
            ctx.save();
            ctx.scale(-1, 1);
            ctx.drawImage(video, -canvas.width, 0, canvas.width, canvas.height);
            ctx.restore();

            // 2. Update & Draw Mosquitoes
            state.mosquitoes.forEach(mosq => {
                mosq.update(canvas.width, canvas.height);
                mosq.draw(ctx);
            });

            // 3. Process Hand Collisions & Draw Cursors
            state.detectedHands.forEach(hand => {
                const handPxX = hand.x * canvas.width;
                const handPxY = hand.y * canvas.height;

                // Determine Hand Owner for Battle Mode
                let playerIndex = 0; // 0 = P1 (Left side), 1 = P2 (Right side)
                if (state.mode === 'battle') {
                    playerIndex = hand.x < 0.5 ? 0 : 1;
                }

                // Check collision with mosquitoes
                for (let i = state.mosquitoes.length - 1; i >= 0; i--) {
                    const mosq = state.mosquitoes[i];

                    // Battle area restriction check
                    if (state.mode === 'battle') {
                        if (playerIndex === 0 && mosq.areaSide !== 'left') continue;
                        if (playerIndex === 1 && mosq.areaSide !== 'right') continue;
                    }

                    if (checkHandCollision(hand, mosq, canvas.width, canvas.height)) {
                        DOM.diagCollision.innerText = `Hit ${mosq.number} (P${playerIndex+1})`;

                        if (mosq.number === state.targetNumber) {
                            // CORRECT CATCH!
                            playSound('splat');
                            showFeedbackToast(true, 'HEBAT ON TARGET!');
                            speakInstruction("Hebat sekali!");

                            if (state.mode === 'solo') {
                                state.scoreSolo += 10;
                                DOM.soloScoreDisplay.innerText = state.scoreSolo;
                            } else {
                                if (playerIndex === 0) {
                                    state.scoreP1 += 10;
                                    DOM.battleP1ScoreDisplay.innerText = state.scoreP1;
                                } else {
                                    state.scoreP2 += 10;
                                    DOM.battleP2ScoreDisplay.innerText = state.scoreP2;
                                }
                            }

                            // Advance to next round automatically
                            startNewRound();
                            break;
                        } else {
                            // WRONG CATCH!
                            playSound('wrong');
                            showFeedbackToast(false, 'BELUM TEPAT!');
                            speakInstruction("Belum tepat, coba lagi!");
                            
                            // Remove wrong mosquito to prevent spamming
                            state.mosquitoes.splice(i, 1);
                            break;
                        }
                    }
                }

                // Draw Interactive Hand Cursor Indicator
                ctx.beginPath();
                ctx.arc(handPxX, handPxY, 30, 0, Math.PI * 2);
                ctx.fillStyle = playerIndex === 0 ? 'rgba(16, 185, 129, 0.4)' : 'rgba(168, 85, 247, 0.4)';
                ctx.fill();
                ctx.lineWidth = 3;
                ctx.strokeStyle = playerIndex === 0 ? '#10b981' : '#a855f7';
                ctx.stroke();

                ctx.beginPath();
                ctx.arc(handPxX, handPxY, 6, 0, Math.PI * 2);
                ctx.fillStyle = '#ffffff';
                ctx.fill();
            });

            requestAnimationFrame(runGameLoop);
        }

        /* ==========================================================================
           UI FEEDBACK & NOTIFICATIONS
           ========================================================================== */
        function showFeedbackToast(isCorrect, message) {
